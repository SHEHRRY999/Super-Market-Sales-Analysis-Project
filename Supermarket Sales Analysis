## ----stats------------------------------------------------------------------
get_mode <- function(x) {
  freq <- table(x)
  as.numeric(names(freq[freq == max(freq)]))
}

num_cols <- c("Unit.price", "Quantity", "Total", "Rating")
stats_table <- data.frame()

for (col in num_cols) {
  x <- sales_raw[[col]]
  stats_table <- rbind(stats_table, data.frame(
    Mean     = mean(x),
    Median   = median(x),
    Mode     = get_mode(x)[1],
    Min      = min(x),
    Max      = max(x),
    Range    = max(x) - min(x),
    Variance = var(x),
    SD       = sd(x),
    Q1       = quantile(x, 0.25),
    Q3       = quantile(x, 0.75),
    IQR      = IQR(x),
    CV_pct   = sd(x) / mean(x) * 100
  ))
}
rownames(stats_table) <- num_cols

# Show with variables as columns so that the table fits the page
round(t(stats_table), 2)


