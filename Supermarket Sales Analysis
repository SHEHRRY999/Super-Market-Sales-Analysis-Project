## ----t-date-----------------------------------------------------------------
sales$Month   <- format(sales$Date, "%B")
sales$Weekday <- format(sales$Date, "%A")

sales$Month   <- factor(sales$Month,
                        levels = c("January", "February", "March"))
sales$Weekday <- factor(sales$Weekday,
                        levels = c("Monday", "Tuesday", "Wednesday",
                                   "Thursday", "Friday", "Saturday",
                                   "Sunday"))
head(sales[, c("Date", "Month", "Weekday")])


## ----t-time-----------------------------------------------------------------
sales$Hour <- as.integer(gsub(":.*", "", sales$Time))

sales <- sales %>%
  mutate(Time_Of_Day = case_when(Hour < 12 ~ "Morning",
                                 Hour < 17 ~ "Afternoon",
                                 TRUE      ~ "Evening"))
sales$Time_Of_Day <- factor(sales$Time_Of_Day,
                            levels = c("Morning", "Afternoon", "Evening"))

head(sales[, c("Time", "Hour", "Time_Of_Day")])
table(sales$Time_Of_Day)


## ----t-size-----------------------------------------------------------------
q <- quantile(sales$Total)
q

sales <- sales %>%
  mutate(Sale_Size = case_when(Total <= q[2] ~ "Small",
                               Total <= q[4] ~ "Medium",
                               TRUE          ~ "Large"))
sales$Sale_Size <- factor(sales$Sale_Size,
                          levels = c("Small", "Medium", "Large"))
table(sales$Sale_Size)


## ----t-rating---------------------------------------------------------------
sales <- sales %>%
  mutate(Rating_Level = case_when(Rating < 6  ~ "Low",
                                  Rating <= 8 ~ "Medium",
                                  TRUE        ~ "High"))
sales$Rating_Level <- factor(sales$Rating_Level,
                             levels = c("Low", "Medium", "High"))
table(sales$Rating_Level)
round(prop.table(table(sales$Rating_Level)) * 100, 1)


## ----t-minmax---------------------------------------------------------------
sales$Total_Normalized <- (sales$Total - min(sales$Total)) /
                          (max(sales$Total) - min(sales$Total))
summary(sales$Total_Normalized)


## ----t-log------------------------------------------------------------------
sales$Total_Log10 <- log10(sales$Total)
summary(sales$Total_Log10)
cat("Mean vs median of Total       :", round(mean(sales$Total), 1), "vs",
