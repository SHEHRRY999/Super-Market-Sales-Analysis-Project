## ----clean-apply------------------------------------------------------------
sales <- sales_raw
cat("Rows before cleaning:", nrow(sales), "\n")

sales <- sales[!duplicated(sales), ]       # remove duplicate records
sales <- na.omit(sales)                    # remove rows with missing values

# keep only rows that satisfy the logical rules
sales <- sales[sales$Unit.price > 0 & sales$Quantity >= 1 &
               sales$Rating >= 1 & sales$Rating <= 10 &
               sales$Total > 0, ]

# remove extra spaces from every text column
for (col in cat_cols) {
  sales[[col]] <- trimws(sales[[col]])
}

cat("Rows after cleaning :", nrow(sales), "\n")


## ----drop-cols--------------------------------------------------------------
sales$gross.margin.percentage <- NULL      # constant column
sales$gross.income <- NULL                 # identical to Tax.5.
names(sales)


## ----rename-----------------------------------------------------------------
sales <- sales %>%
  rename(Invoice_ID    = Invoice.ID,
         Customer_Type = Customer.type,
         Product_Line  = Product.line,
         Unit_Price    = Unit.price,
         Tax           = Tax.5.)
names(sales)


## ----types------------------------------------------------------------------
sales$Date <- as.Date(sales$Date, format = "%m/%d/%Y")

factor_cols <- c("Branch", "City", "Customer_Type", "Gender",
                 "Product_Line", "Payment")
for (col in factor_cols) {
  sales[[col]] <- factor(sales[[col]])
}

sapply(sales, class)


